# ==============================================================================
# SETU-NETRA .gitignore
# ==============================================================================

# Python Bytecode and Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Virtual Environments
.venv/
venv/
env/
ENV/
.env_test/
env.bak/
venv.bak/

# Node.js and Frontend Artifacts
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
*.tsbuildinfo
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing, Coverage, and Profiling
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
nosetests.xml
coverage.xml
*.cover
.tox/

# IDE, Editor, and OS Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Temporary Runtime Uploads and System Logs
output/uploads/
*.log

# Sensitive Files and Credentials (NEVER COMMIT)
*.env
*.env.local
*.env.*.local
*.pem
*.key
*.p12
*.pfx
credentials.json
client_secret.json
id_rsa
id_ed25519
